enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  password            String
  first_name          String
  last_name           String
  role                Role
  has_validated_email Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  provider_profile    ProviderProfile?
}
